# sandcastle's own secrets and settings. Not your app's env (that is .env.sandbox).
# Gitignored. It can live in two places; the second wins on a clash:
#   <sandcastle clone>/.env.orchestrator     shared by every project on this machine
#   <project>/.sandcastle/.env.orchestrator  this project only (or <stateDir>/.env.orchestrator)
# `sandcastle init` creates the project one from this file.
# Read by the HOST orchestrator only. Never copied into a worktree, never mounted into an
# agent container.

# Fine-grained PAT the agents use inside their containers to push branches and open PRs.
# Needs contents:write + pull-requests:write on every repo under `repos` in the project config.
# Deliberately narrow: issue writes (labels, comments) go through the host's own `gh auth`.
GH_TOKEN=

# Agent login. Leave both empty to use the Claude subscription already logged in on this
# host (the mounted ~/.claude/.credentials.json, as on Windows and Linux).
#
# Subscription login without a credentials file (macOS keeps it in the Keychain), or a
# separate login for runs: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
#
# Or bill agents to an API key instead of a subscription.
ANTHROPIC_API_KEY=

# Codex CLI stages (`agents` in config.json). Leave empty to use the ChatGPT login from
# `codex login` on this host (~/.codex/auth.json), or bill an OpenAI API key instead.
# OPENAI_API_KEY is accepted as a fallback name.
CODEX_API_KEY=

# Optional overrides of the project config.
# SANDCASTLE_MODEL=opus
# SANDCASTLE_REVIEW_MODEL=sonnet
# SANDCASTLE_IMAGE=sandcastle:latest
# SANDCASTLE_IDLE_TIMEOUT=1200
# Per repo, upper-case with "-" as "_": SANDCASTLE_BOOTSTRAP_<REPO>, SANDCASTLE_CHECKS_<REPO>
# SANDCASTLE_CHECKS_API=npm test
# Exported as JEST_MAX_WORKERS in every container: a count (4) or a share (50%).
# SANDCASTLE_JEST_WORKERS=4
# Rework rounds an item gets when review asks for rework or its gate is red (default 3; 0 parks at once)
# SANDCASTLE_REWORK_LIMIT=3
# Fix rounds a red Feature Verify gets on the integration branch before the parent parks (default 3)
# SANDCASTLE_FEATURE_REWORK_LIMIT=3

# Layout. Read from this file as well as the process env. Defaults: repos.<name>.path from the
# project config, ~/.sandcastle/worktrees/<project>, ~/.claude, and
# ~/.claude/projects/<project slug>/memory.
# SANDCASTLE_WORKSPACE_ROOT=/home/you/src          # every repo at <root>/<repo name> instead
# SANDCASTLE_WORKTREE_DIR=/home/you/sandcastle-worktrees
# SANDCASTLE_CLAUDE_HOME=/home/you/.claude
# SANDCASTLE_CODEX_HOME=/home/you/.codex
# SANDCASTLE_MEMORY_DIR=/home/you/.claude/projects/<slug>/memory

# Where the agents' memories, skills, commands and credentials come from. When set, every
# start (and `sandcastle sync-claude`) copies them into SANDCASTLE_CLAUDE_HOME first. Useful
# when the orchestrator runs in WSL but you work in Windows.
# SANDCASTLE_CLAUDE_SOURCE=/mnt/c/Users/<you>/.claude

# Feature Verify, compose strategy only: per-repo overrides of verify.services.
# SANDCASTLE_VERIFY_MONGO_IMAGE=mongo:7
# SANDCASTLE_VERIFY_BUILD_<REPO>= / _SEED_ / _SERVE_ / _PORT_ / _HEALTH_
