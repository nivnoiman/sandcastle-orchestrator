{
  "name": "demo",
  "hubRepo": "example-org/hub",
  "integrationBase": "dev",
  "ui": { "port": 7790 },
  "repos": {
    "api": {
      "github": "example-org/api",
      "path": "../api",
      "bootstrap": "npm ci",
      "checks": "npx tsc --noEmit && npx jest --ci"
    },
    "web": {
      "github": "example-org/web",
      "path": "../web",
      "bootstrap": "npm ci",
      "checks": "npx tsc -b && npm run build"
    }
  },
  "verify": {
    "strategy": "compose",
    "mongo": "mongo:7",
    "externalProviders": ["Payments provider", "SMS gateway"],
    "services": {
      "api": {
        "build": "npm ci && npm run build",
        "seed": "npm run migrations:run",
        "serve": "npm start",
        "port": 5000,
        "healthPath": "/api/health",
        "env": { "MONGO_URI": "{{mongoUri}}", "MONGO_DB": "{{mongoDb}}", "BASE_URL": "{{url:api}}" }
      },
      "web": {
        "build": "npm ci && npm run build",
        "serve": "npx vite preview --host 0.0.0.0 --port 4173",
        "port": 4173,
        "env": { "VITE_API_BASE_URL": "{{url:api}}" }
      }
    }
  }
}
